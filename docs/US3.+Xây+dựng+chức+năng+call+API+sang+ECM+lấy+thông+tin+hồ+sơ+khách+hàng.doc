hi=E1=BB=87n giao d=E1=BB=8Bch (<strong><span>&nbsp;</span>m=E1=BB=A5c 3.1.=
3.2 v=C3=A0 3.1.3.3)</strong></li>
<li>B=E1=BA=A3ng k=C3=AA giao d=E1=BB=8Bch c=E1=BB=A7a t=C3=A0i kho=E1=BA=
=A3n =C4=91=C3=A1ng ng=E1=BB=9D (<strong>m=E1=BB=A5c 3.1.3.4</strong>)</li>
<li>Th=C3=B4ng tin giao d=E1=BB=8Bch =C4=91=C3=A1ng ng=E1=BB=9D (<span>&nbs=
p;</span><strong>m=E1=BB=A5c 3.1.3.5</strong>)</li>
<li>File th=C3=B4ng tin =C4=91=E1=BA=A7u v=C3=A0o nghi=E1=BB=87p v=E1=BB=A5=
 upload t=E1=BA=A1i b=C6=B0=E1=BB=9Bc 2 (<span>&nbsp;</span><strong>m=E1=BB=
=A5c 3.1.3.1</strong>)</li>
</ul><p>Sau khi truy xu=E1=BA=A5t d=E1=BB=AF li=E1=BB=87u . c=C3=A1c file b=
=C3=A1o c=C3=A1o m=C3=A0 KDL tr=E1=BA=A3 v=E1=BB=81 c=E1=BA=A7n =C4=91=C6=
=B0=E1=BB=A3c t=E1=BB=95ng h=E1=BB=A3p v=C3=A0o 1 Folder ch=E1=BB=A9a c=C3=
=BA ph=C3=A1p 'B=C3=A1o c=C3=A1o GD =C4=91=C3=A1ng ng=E1=BB=9D' ho=E1=BA=B7=
c 'STR'&nbsp;</p><p>Link File l=C6=B0u tr=E1=BB=AF/ nh=E1=BA=ADn c=C3=A1c f=
older b=C3=A1o c=C3=A1o =C4=91=C6=B0=E1=BB=A3c Kh=E1=BB=91i d=E1=BB=AF li=
=E1=BB=87u g=E1=BB=ADi v=E1=BB=81:&nbsp;</p><p><strong>L=C6=B0u =C3=BD:</st=
rong>&nbsp;File l=C6=B0u c=C3=A1c folder b=C3=A1o c=C3=A1o c=E1=BA=A7n =C4=
=91=C6=B0=E1=BB=A3c c=E1=BA=A5p quy=E1=BB=81n truy c=E1=BA=ADp t=E1=BB=9Bi =
